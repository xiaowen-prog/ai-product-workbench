AGENT_DATA_DIR=../data
AGENT_DB_PATH=../data/agent_workbench.sqlite3
AGENT_ARTIFACT_DIR=../data/artifacts
AGENT_OWNER_ID=default-owner

# Storage mode. Keep `sql` for local development. `cloudbase_rest` hydrates a
# short-lived local ORM cache and mirrors every committed row to CloudBase.
# Run migrations/001_init.sql before switching a deployed service to it.
DATA_BACKEND=sql
CLOUDBASE_ENV_ID=
CLOUDBASE_API_KEY=
CLOUDBASE_REST_URL=
CLOUDBASE_TABLE_PREFIX=agent_workbench_

# Runtime model configuration. Keep the key empty until a provider smoke test is ready.
# Do not commit a real value for AGENT_MODEL_API_KEY.
AGENT_MODEL_PROVIDER=openai-compatible
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_MODEL_API_KEY=
AGENT_MODEL_TIMEOUT_SECONDS=45

# Comma-separated browser origins. Set the deployed frontend origin in production.
AGENT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Production auth. Keep REQUIRE_LOGIN=0 for local development; set it to 1 in
# CloudBase and provide invite codes as `code:label` pairs plus a 16+ char secret.
REQUIRE_LOGIN=0
INVITE_CODES=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=2592000
COOKIE_SECURE=0
PROXY_SHARED_SECRET=
CLIENT_IP_HEADER=x-envoy-external-address
